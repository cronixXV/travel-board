{
  "name": "wanderboard",
  "private": true,
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w client",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w server && npm run typecheck -w client",
    "lint": "eslint \"{client,server,shared}/src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"{client,server,shared}/src/**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"{client,server,shared}/src/**/*.{ts,tsx,json,css,md}\"",
    "clean": "rm -rf client/dist server/dist shared/dist"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.0"
  },
  "dependencies": {
    "react-dropzone": "^14.3.8"
  }
}
