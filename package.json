{
  "name": "wanderboard",
  "private": true,
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w client",
    "typecheck": "npm run typecheck -w shared && npm run build -w shared && npm run typecheck -w server && npm run typecheck -w client",
    "lint": "npm run lint:root && npm run lint -w client",
    "lint:root": "eslint \"server/src/**/*.{ts,tsx}\" \"shared/**/*.{ts,tsx}\" \"server/**/*.{js,cjs}\" \"*.config.{js,cjs}\"",
    "format": "prettier --write \"{client,server,shared}/src/**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"{client,server,shared}/src/**/*.{ts,tsx,json,css,md}\"",
    "clean": "rm -rf client/dist server/dist shared/dist",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed --workers=1",
    "e2e:debug": "PWDEBUG=1 playwright test --headed --workers=1",
    "e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "concurrently": "^8.2.0",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "prettier": "^3.2.0",
    "typescript-eslint": "^8.60.1"
  }
}
