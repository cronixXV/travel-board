# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wanderboard
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:postgres@db:5432/wanderboard

# JWT
JWT_SECRET=example_super_secret_jwt_key_minimum_32_chars
JWT_REFRESH_SECRET=example_super_secret_refresh_key_minimum_32_chars

# CORS
CLIENT_URL=http://localhost:5173

# Public URLs for share / OG preview
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3000

# Vite client vars
VITE_API_URL=http://localhost:3000
VITE_PUBLIC_APP_URL=http://localhost:3000

# Static client build path inside server container
CLIENT_DIST_PATH=/app/client/dist